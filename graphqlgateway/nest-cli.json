{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/graphqlgateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/graphqlgateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/graphqlgateway",
  "projects": {
    "graphqlgateway": {
      "type": "application",
      "root": "apps/graphqlgateway",
      "entryFile": "main",
      "sourceRoot": "apps/graphqlgateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/graphqlgateway/tsconfig.app.json"
      }
    },
    "categories": {
      "type": "application",
      "root": "apps/categories",
      "entryFile": "main",
      "sourceRoot": "apps/categories/src",
      "compilerOptions": {
        "tsConfigPath": "apps/categories/tsconfig.app.json"
      }
    },
    "products": {
      "type": "application",
      "root": "apps/products",
      "entryFile": "main",
      "sourceRoot": "apps/products/src",
      "compilerOptions": {
        "tsConfigPath": "apps/products/tsconfig.app.json"
      }
    },
    "subcategories": {
      "type": "application",
      "root": "apps/subcategories",
      "entryFile": "main",
      "sourceRoot": "apps/subcategories/src",
      "compilerOptions": {
        "tsConfigPath": "apps/subcategories/tsconfig.app.json"
      }
    },
    "ecommercedata": {
      "type": "application",
      "root": "apps/ecommercedata",
      "entryFile": "main",
      "sourceRoot": "apps/ecommercedata/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ecommercedata/tsconfig.app.json"
      }
    },
    "users": {
      "type": "application",
      "root": "apps/users",
      "entryFile": "main",
      "sourceRoot": "apps/users/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users/tsconfig.app.json"
      }
    }
  }
}